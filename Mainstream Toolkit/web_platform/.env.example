DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# SQLite is the local default. For PostgreSQL, supply POSTGRES_DB, POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_HOST, POSTGRES_PORT, and POSTGRES_SSLMODE.
# Production also requires DJANGO_DEBUG=0 and a unique DJANGO_SECRET_KEY.

# Membership card payments: configure test keys first, then explicitly enable.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bitcoin index must be HTTPS mainnet ord with inscription, sat and rune indexing.
ORDINAL_INDEX_URL=
ORDINAL_TRADING_ENABLED=0
DIRECT_BITCOIN_ENABLED=0
SEMANTIC_ENABLED=0

# Optional supplied catalog IDs (001 Writer, 002 Unlock in ../.env.stripe)
STRIPE_WRITER_PRODUCT_ID=
STRIPE_WRITER_PRICE_ID=
STRIPE_UNLOCK_PRODUCT_ID=
STRIPE_UNLOCK_PRICE_ID=

# Public receiving wallets; never paste seeds or private keys.
PORTAL_MEMBERSHIP_WALLET=bc1qhke8vfglf2t2gu8tv7pm3x7yma3uz8ucndfaex
ORDINAL_FEES_WALLET=bc1qzs2nsqjhx8hnrg4vvlzzpmp3smjkh0xl75h90g
REDEMPTION_WALLET=bc1qwfsp8c2af6lxkmqmddu53s7pcmck6936rwg8wm
ORDINAL_PLATFORM_FEE_SATS=0
BITCOIN_FEE_URL=https://mempool.space/api/v1/fees/recommended
# Gamma's public mainnet ord JSON API supports sat and rune indexing:
# ORDINAL_INDEX_URL=https://ord-mainnet.gamma.io
