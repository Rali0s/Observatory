DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# SQLite is the local default. For PostgreSQL, supply POSTGRES_DB, POSTGRES_USER,
# POSTGRES_PASSWORD, POSTGRES_HOST, POSTGRES_PORT, and POSTGRES_SSLMODE.
# Production also requires DJANGO_DEBUG=0 and a unique DJANGO_SECRET_KEY.

# Membership card payments: configure test keys first, then explicitly enable.
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Bitcoin index must be HTTPS mainnet ord with inscription, sat and rune indexing.
ORDINAL_INDEX_URL=
ORDINAL_TRADING_ENABLED=0
DIRECT_BITCOIN_ENABLED=0
SEMANTIC_ENABLED=0
